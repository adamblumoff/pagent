DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pagent
PAGENT_ADMIN_TOKEN=replace-with-a-relay-admin-token
PAGENT_SOURCE_TOKEN=replace-with-a-source-token
PAGENT_CONNECTOR_TOKEN=replace-with-a-connector-token
PAGENT_REPOSITORY_KEY=pagent-demo
PAGENT_CONNECTOR_ID=demo-laptop
PAGENT_ALLOWED_ENVIRONMENTS=staging,production
PAGENT_SSE_HEARTBEAT_MS=15000
PAGENT_ACKNOWLEDGED_CONTEXT_RETENTION_MS=86400000
PORT=3000

# For more than one source or connector, use JSON instead of the single-value
# variables above. Tokens route events without trusting routing data from the SDK.
# PAGENT_SOURCES_JSON=[{"token":"source-secret","repositoryKey":"demo","connectorId":"laptop","allowedEnvironments":["staging"]}]
# PAGENT_CONNECTORS_JSON=[{"id":"laptop","token":"connector-secret"}]

# A fresh relay can start with DATABASE_URL and PAGENT_ADMIN_TOKEN only.
# The static source and connector variables above remain available for existing setups.
