{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pagent-provisioner",
  "account_id": "7668e16c839b89abc63bbb8bb96f5c61",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Set PAGENT_PROVISIONER_ADMIN_TOKEN, PAGENT_CREDENTIAL_SECRET, and the Cloudflare API
  // credentials with `wrangler secret put`. Enrollment tokens are minted by
  // the admin endpoint and are never configured as reusable Worker secrets.
  "kv_namespaces": [
    {
      "binding": "PAGENT_ENVIRONMENTS",
      "id": "4ad82e50e3ca4436ad19da2b1a584ae0",
      "preview_id": "c9b337c69de54bec9aba12c07298cd54"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAGENT_ENROLLMENT_LOCKS",
        "class_name": "EnrollmentTokenLock"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EnrollmentTokenLock"]
    }
  ]
}
