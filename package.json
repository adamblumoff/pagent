{
  "name": "pagent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm --prefix relay run build",
    "connector": "tsx demo/connector.ts",
    "demo": "tsx demo/cloud-server.ts",
    "demo:local": "tsx demo/server.ts",
    "test": "vitest run && npm --prefix relay test",
    "typecheck": "tsc --noEmit && npm --prefix relay run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
